# GEMINI_API_KEY: Required for Gemini AI API calls.
# Configure securely via environment variables or AI Studio Secrets (never commit real secrets).
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL=""

# PAYMENT_GATEWAY_ENABLED: Set to "true" only after live gateway authorization and secret setup.
PAYMENT_GATEWAY_ENABLED="false"
PAYMENT_GATEWAY_KEY_ID=""
PAYMENT_GATEWAY_KEY_SECRET=""

# Firebase / Admin Authorization (Configure outside source code in runtime secrets / .env)
# Comma-separated verified owner/admin emails or Firebase Auth UIDs.
# Owner/Admin accounts must authenticate via Firebase Authentication.
OWNER_ADMIN_EMAILS=""
OWNER_ADMIN_UIDS=""
FIREBASE_PROJECT_ID=""
FIREBASE_DATABASE_ID=""
