rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedEmail() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrappedOwner() {
      return isVerifiedEmail() && request.auth.token.email == 'joydas.21071997@gmail.com';
    }

    function isOwnerOrAdmin() {
      return isBootstrappedOwner() || (
        isVerifiedEmail() && (
          request.auth.token.role == 'owner' ||
          request.auth.token.role == 'admin' ||
          request.auth.token.admin == true
        )
      );
    }

    function isAuthorizedMediaEditor() {
      return isVerifiedEmail() &&
        request.auth.token.role == 'editor' && (
          request.auth.token.manage_media == true ||
          (request.auth.token.permissions is list && 'manage_media' in request.auth.token.permissions)
        );
    }

    function canUploadMedia() {
      return isOwnerOrAdmin() || isAuthorizedMediaEditor();
    }

    function isValidImageFile(fileName) {
      return fileName.matches('^.+\\.([jJ][pP][eE]?[gG]|[pP][nN][gG]|[wW][eE][bB][pP])$') &&
        request.resource != null &&
        request.resource.size > 0 &&
        request.resource.size <= 10 * 1024 * 1024 &&
        request.resource.contentType.matches('^image/(jpeg|png|webp)$');
    }

    function isValidAudioFile(fileName) {
      return fileName.matches('^.+\\.([mM][pP]3|[wW][aA][vV]|[oO][gG][gG]|[mM]4[aA]|[wW][eE][bB][mM])$') &&
        request.resource != null &&
        request.resource.size > 0 &&
        request.resource.size <= 150 * 1024 * 1024 &&
        request.resource.contentType.matches('^audio/(mpeg|mp3|wav|x-wav|ogg|mp4|x-m4a|aac|webm)$');
    }

    function isValidVideoFile(fileName) {
      return fileName.matches('^.+\\.([mM][pP]4|[wW][eE][bB][mM]|[mM][oO][vV]|[mM][kK][vV])$') &&
        request.resource != null &&
        request.resource.size > 0 &&
        request.resource.size <= 150 * 1024 * 1024 &&
        request.resource.contentType.matches('^video/(mp4|webm|quicktime|x-matroska)$');
    }

    function isValidMediaPayload(folder, fileName) {
      return (folder == 'artwork' && isValidImageFile(fileName)) ||
        (folder == 'audio' && isValidAudioFile(fileName)) ||
        (folder == 'video' && isValidVideoFile(fileName));
    }

    // Protected Premium Story Media: NEVER publicly readable by regular users or anonymous callers.
    // Served only through backend entitlement verification and short-lived signed delivery.
    match /stories/premium/{folder}/{fileName} {
      allow read: if isOwnerOrAdmin();
      allow create: if canUploadMedia() &&
        folder in ['audio', 'video'] &&
        isValidMediaPayload(folder, fileName);
      allow update: if isOwnerOrAdmin() &&
        folder in ['audio', 'video'] &&
        isValidMediaPayload(folder, fileName);
      allow delete: if isOwnerOrAdmin();
    }

    // Free Stories, Public Trailers, and Cover Artwork:
    // Public read preserved; writes strictly restricted to authorized Owner/Admin or manage_media Editor.
    match /stories/free/{folder}/{fileName} {
      allow read: if folder in ['audio', 'video', 'artwork'];
      allow create: if canUploadMedia() &&
        folder in ['audio', 'video', 'artwork'] &&
        isValidMediaPayload(folder, fileName);
      allow update: if isOwnerOrAdmin() &&
        folder in ['audio', 'video', 'artwork'] &&
        isValidMediaPayload(folder, fileName);
      allow delete: if isOwnerOrAdmin();
    }

    // Legacy Public Media Path Compatibility (preserves existing free/trailer/artwork URLs):
    // Direct overwrites and deletions are strictly restricted to Owner/Admin; creates require staff media claim.
    match /stories/{folder}/{fileName} {
      allow read: if folder in ['audio', 'video', 'artwork'];
      allow create: if canUploadMedia() &&
        folder in ['audio', 'video', 'artwork'] &&
        isValidMediaPayload(folder, fileName);
      allow update: if isOwnerOrAdmin() &&
        folder in ['audio', 'video', 'artwork'] &&
        isValidMediaPayload(folder, fileName);
      allow delete: if isOwnerOrAdmin();
    }

    // Default deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
