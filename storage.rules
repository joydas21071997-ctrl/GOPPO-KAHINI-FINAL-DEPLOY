rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Public read for published cover art, trailers, and streaming audio/video under stories/
    match /stories/{folder}/{fileName} {
      allow read: if folder in ['audio', 'video', 'artwork'];
      allow write: if request.auth != null
        && request.auth.token.email_verified == true
        && folder in ['audio', 'video', 'artwork']
        && request.resource.size <= 150 * 1024 * 1024
        && (
          request.resource.contentType.matches('audio/.*') ||
          request.resource.contentType.matches('video/.*') ||
          request.resource.contentType.matches('image/.*')
        );
    }

    // Deny all other storage paths by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
